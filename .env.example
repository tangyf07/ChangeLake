# ChangeLake Phase 1 — demo credentials ONLY. Do not use in production.

# MySQL
MYSQL_ROOT_PASSWORD=changelake
MYSQL_DATABASE=changelake
MYSQL_USER=changelake
MYSQL_PASSWORD=changelake
MYSQL_PORT=3306
MYSQL_HOST=localhost

# Flink UI (JobManager REST)
FLINK_UI_PORT=8081

# Paimon (filesystem catalog warehouse inside containers)
PAIMON_WAREHOUSE=/warehouse

# Seed
SEED=42

# Paimon JAR version (must match Flink major.minor)
# Docs: https://paimon.apache.org/docs/1.4/flink/quick-start/
PAIMON_VERSION=1.4.2
FLINK_VERSION=1.18.1
