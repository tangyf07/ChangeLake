# ChangeLake Phase 4 — demo credentials ONLY. Do not use in production.

# MySQL
MYSQL_ROOT_PASSWORD=changelake
MYSQL_DATABASE=changelake
MYSQL_USER=changelake
MYSQL_PASSWORD=changelake
MYSQL_PORT=3306
MYSQL_HOST=localhost

# Flink UI (JobManager REST). Change if 8081 is already bound on the host.
FLINK_UI_PORT=8081

# MinIO (S3-compatible) — DEMO-ONLY keys. Never use in production.
# Paimon warehouse lives on MinIO (not local file:///warehouse).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Endpoint as seen from Flink containers (compose service DNS).
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=changelake
# Path-style required for standalone MinIO (Paimon s3.path.style.access).
S3_PATH_STYLE_ACCESS=true

# Paimon warehouse URI on MinIO (bucket/path). Docs:
# https://paimon.apache.org/docs/1.4/maintenance/filesystems/
PAIMON_WAREHOUSE=s3://changelake/warehouse

# Seed
SEED=42

# Pinned versions (must stay consistent with bootstrap.sh / README)
PAIMON_VERSION=1.4.2
FLINK_VERSION=1.18.1
FLINK_CDC_VERSION=3.1.1
MYSQL_JDBC_VERSION=8.0.33

# CDC wait (seconds) for Golden Path G1–G6
CDC_WAIT_TIMEOUT=180
CDC_POLL_INTERVAL=5
PIPELINE_JOB_NAME=changelake-ods-cdc
